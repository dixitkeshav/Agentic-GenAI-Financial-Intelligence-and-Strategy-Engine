# Template for Vercel — copy to .env.vercel, fill placeholders, import in Vercel dashboard.
# Vercel → Settings → Environment Variables → Import .env → select Production

# Render Postgres → Connections → External Database URL (NOT Internal — Vercel cannot use Internal)
DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxx-a.oregon-postgres.render.com/fintelli?sslmode=require
NEXT_PUBLIC_API_URL=https://fintelli-ai.onrender.com
NEXT_PUBLIC_WS_URL=wss://fintelli-ai.onrender.com
NEXTAUTH_URL=https://fintelli-ai-one.vercel.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
DASHBOARD_PASSWORD=your-demo-password
EDGE_BROKER=ZERODHA
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
OPENAI_API_KEY=

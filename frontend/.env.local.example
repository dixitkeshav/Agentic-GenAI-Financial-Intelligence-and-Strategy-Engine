# Copy to .env.local — never commit .env.local

# Django API (local dev)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# Shared Postgres — same DATABASE_URL as backend/.env when using Prisma features
# Local: docker compose -f ../docker-compose.edge.yml up -d
DATABASE_URL=postgresql://edge:edge@127.0.0.1:5432/edge?schema=public

EDGE_BROKER=ZERODHA
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

OPENAI_API_KEY=

NEXTAUTH_SECRET=generate_with_openssl_rand_-base64_32
NEXTAUTH_URL=http://localhost:3000
DASHBOARD_PASSWORD=your_demo_password

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

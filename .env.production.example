# ─── Django backend ───────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-use-openssl-rand-hex-32
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_DEBUG=False

ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
NEWSAPI_KEY=

FEATURE_GENAI_INSIGHTS=true
FEATURE_AGENTS=true
FEATURE_QUANT_SIGNALS=true
FEATURE_WEBSOCKETS=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated browser origins (your public frontend URL)
CORS_EXTRA_ORIGINS=http://localhost:3000

# ─── Next.js frontend ─────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-use-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
DASHBOARD_PASSWORD=your_secure_password

OPENAI_API_KEY=
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Public WebSocket URL (browser must reach this host)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Postgres (Prisma / EDGE) ─────────────────────────────────────
POSTGRES_USER=fintelli
POSTGRES_PASSWORD=fintelli
POSTGRES_DB=fintelli

# ─── Ports (optional) ─────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Copy to .env for local Django dev:
#   cp .env.example .env
# Never commit .env (gitignored).

# Market / news
ALPHA_VANTAGE_API_KEY=
NEWSAPI_KEY=
FINNHUB_API_KEY=
INDIAN_API_KEY=

# LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=

# Django
DJANGO_SECRET_KEY=dev-local-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Optional local Postgres (omit to use SQLite db.sqlite3)
# DATABASE_URL=postgresql://edge:edge@127.0.0.1:5432/edge?sslmode=disable

# Optional Redis (local)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

FEATURE_GENAI_INSIGHTS=true
FEATURE_AGENTS=true
FEATURE_QUANT_SIGNALS=true
FEATURE_WEBSOCKETS=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
